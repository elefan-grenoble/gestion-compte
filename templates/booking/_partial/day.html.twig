{% if (display_names ?? true) %}
    {% set display_names = display_name_shifters %}
{% endif %}

<div class="row" style="margin-bottom: 0;">
    <div class="col s12">
        {% include "booking/_partial/lines.html.twig" with {
            bucketsByJob: bucketsByJob,
            start: hours | first,
            end: hours | last,
            card: "booking/_partial/day_bucket.html.twig",
            card_context: { beneficiary: beneficiary, user: app.user, cycle: current_cycle, display_names: display_names }
        } %}
    </div>
</div>
