{% if display_opening_hour_open_closed_header %}
    {% if opening_hour_kind_service.hasEnabled %}
        {% set shop = opening_hour_service.status %}
        <div class="opening-hour-header {% if shop.open %}opening-hour-header--open{% else %}opening-hour-header--closed{% endif %}">
            <strong class="opening-hour-header__status">
                {%- if shop.open %}{{ opening_hour_open_closed_header_open_message }}{% else %}{{ opening_hour_open_closed_header_closed_message }}{% endif -%}
            </strong>
            {% if shop.next %}
                <span class="opening-hour-header__next">
                    {{- '(' }}{% if shop.open %}ferme{% else %}ouvre{% endif %} à {{ shop.next|time_short|trim -}}
                    {%- if shop.nextDay == 'tomorrow' %} demain{% elseif shop.nextDay == 'later' %} le {{ shop.next|date('d/m') }}{% endif -%}
                    {{- ')' -}}
                </span>
            {% endif %}
        </div>
    {% endif %}
{% endif %}
