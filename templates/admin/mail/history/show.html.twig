{% extends 'layout.html.twig' %}

{% block title %}Mail envoyé - {{ site_name }}{% endblock %}

{% block breadcrumbs %}
<a href="{{ path('homepage') }}"><i class="material-icons">home</i></a><i class="material-icons">chevron_right</i>
<a href="{{ path('admin') }}"><i class="material-icons">build</i>&nbsp;Administration</a><i class="material-icons">chevron_right</i>
<a href="{{ path('admin_email_log_index') }}"><i class="material-icons">history</i>&nbsp;Historique des mails</a><i class="material-icons">chevron_right</i>
<i class="material-icons">mail</i>&nbsp;Détail
{% endblock %}

{% block content %}
    <h4>{{ email_log.subject }}</h4>

    <table>
        <tbody>
            <tr>
                <td>Date</td>
                <td>{{ email_log.createdAt | date('d/m/Y H:i:s') }}</td>
            </tr>
            <tr>
                <td>État</td>
                <td>
                    {% if email_log.status == 'sent' %}
                        <span class="green-text"><i class="material-icons tiny">check_circle</i> Envoyé</span>
                        (accepté par le serveur d'envoi ; l'arrivée dans la boîte du destinataire n'est pas vérifiée)
                    {% elseif email_log.status == 'failed' %}
                        <span class="red-text"><i class="material-icons tiny">error</i> Échec</span>
                    {% else %}
                        <span class="orange-text"><i class="material-icons tiny">schedule</i> En attente</span>
                        (en cours de remise au serveur d'envoi, ou l'envoi a été interrompu avant sa réponse)
                    {% endif %}
                </td>
            </tr>
            {% if email_log.error %}
                <tr>
                    <td>Erreur</td>
                    <td><code>{{ email_log.error }}</code></td>
                </tr>
            {% endif %}
            <tr>
                <td>Type</td>
                <td>
                    {% if email_log.source == 'auto' %}
                        Mail automatique
                    {% elseif email_log.source == 'manual' %}
                        Écrit par {% if email_log.sentBy %}{{ email_log.sentBy.username }}{% else %}un administrateur{% endif %} 
                    {% endif %}
                </td>
            </tr>
            <tr>
                <td>Expéditeur</td>
                <td>{{ email_log.fromAddress }}</td>
            </tr>
            <tr>
                <td>Destinataire(s) ({{ email_log.recipientCount }})</td>
                <td>{{ email_log.recipients }}</td>
            </tr>
            {% if batch_summary and batch_summary.total > 1 %}
                <tr>
                    <td>Envoi groupé</td>
                    <td>
                        Ce mail fait partie d'un envoi à {{ batch_summary.total }} destinataires.
                        <a href="{{ path('admin_email_log_batch', {batchId: email_log.batchId}) }}">Voir tous les mails de cet envoi</a>
                    </td>
                </tr>
            {% endif %}
            {% if email_log.messageId %}
                <tr>
                    <td>Message-ID</td>
                    <td><small>{{ email_log.messageId }}</small></td>
                </tr>
            {% endif %}
        </tbody>
    </table>

    <h5>Contenu</h5>
    {% if body %}
        {% if batch_summary and batch_summary.total > 1 %}
            <p class="grey-text">Texte commun à l'envoi, avant personnalisation.</p>
        {% endif %}
        <iframe sandbox srcdoc="{{ body | e('html_attr') }}" style="width: 100%; height: 400px; border: 1px solid #ccc;"></iframe>
    {% else %}
        <p class="grey-text">Le contenu des mails automatiques n'est pas conservé.</p>
    {% endif %}

    <p>
        <a href="{{ path('admin_email_log_index') }}" class="btn white red-text"><i class="material-icons left">arrow_back</i>Retour</a>
    </p>
{% endblock %}
