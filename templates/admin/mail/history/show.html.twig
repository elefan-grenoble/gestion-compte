{% extends 'layout.html.twig' %}

{% block title %}Mail envoyé - {{ site_name }}{% endblock %}

{% block breadcrumbs %}
<a href="{{ path('homepage') }}"><i class="material-icons">home</i></a><i class="material-icons">chevron_right</i>
<a href="{{ path('admin') }}"><i class="material-icons">build</i>&nbsp;Administration</a><i class="material-icons">chevron_right</i>
<a href="{{ path('admin_sent_email_index') }}"><i class="material-icons">history</i>&nbsp;Historique des mails</a><i class="material-icons">chevron_right</i>
<i class="material-icons">mail</i>&nbsp;Détail
{% endblock %}

{% block content %}
    <h4>{{ sent_email.subject }}</h4>

    <table>
        <tbody>
            <tr>
                <td>Date</td>
                <td>{{ sent_email.createdAt | date('d/m/Y H:i:s') }}</td>
            </tr>
            <tr>
                <td>État</td>
                <td>
                    {% if sent_email.status == 'sent' and sent_email.error %}
                        <span class="orange-text"><i class="material-icons tiny">warning</i> Envoyé, avec des échecs</span>
                        (le serveur d'envoi a refusé certains destinataires, voir l'erreur ci-dessous)
                    {% elseif sent_email.status == 'sent' %}
                        <span class="green-text"><i class="material-icons tiny">check_circle</i> Envoyé</span>
                        (accepté par le serveur d'envoi ; l'arrivée dans la boîte du destinataire n'est pas vérifiée)
                    {% elseif sent_email.status == 'failed' %}
                        <span class="red-text"><i class="material-icons tiny">error</i> Échec</span>
                    {% else %}
                        <span class="orange-text"><i class="material-icons tiny">schedule</i> En attente</span>
                        (pas encore remis au serveur d'envoi : il part en arrière-plan dans les minutes qui suivent, ou l'envoi a été interrompu)
                    {% endif %}
                </td>
            </tr>
            {% if sent_email.error %}
                <tr>
                    <td>Erreur</td>
                    <td><code>{{ sent_email.error }}</code></td>
                </tr>
            {% endif %}
            <tr>
                <td>Type</td>
                <td>
                    {% if sent_email.source == 'auto' %}
                        Mail automatique
                    {% elseif sent_email.source == 'manual' %}
                        Écrit par {% if sent_email.sentBy %}{{ sent_email.sentBy.username }}{% else %}un administrateur{% endif %} 
                    {% endif %}
                </td>
            </tr>
            <tr>
                <td>Expéditeur</td>
                <td>{{ sent_email.fromAddress }}</td>
            </tr>
            <tr>
                <td>Destinataire(s) ({{ sent_email.recipientCount }})</td>
                <td>{{ sent_email.recipients }}</td>
            </tr>
            {% if batch_summary and batch_summary.total > 1 %}
                <tr>
                    <td>Envoi groupé</td>
                    <td>
                        Ce mail fait partie d'un envoi à {{ batch_summary.total }} destinataires.
                        <a href="{{ path('admin_sent_email_batch', {batchId: sent_email.batchId}) }}">Voir tous les mails de cet envoi</a>
                    </td>
                </tr>
            {% endif %}
            {% if sent_email.messageId %}
                <tr>
                    <td>Message-ID</td>
                    <td><small>{{ sent_email.messageId }}</small></td>
                </tr>
            {% endif %}
        </tbody>
    </table>

    <h5>Contenu</h5>
    {% if sent_email.body %}
        <iframe sandbox srcdoc="{{ sent_email.body | e('html_attr') }}" style="width: 100%; height: 400px; border: 1px solid #ccc;"></iframe>
    {% else %}
        <p class="grey-text">Le contenu des mails automatiques n'est pas conservé.</p>
    {% endif %}

    <p>
        <a href="{{ path('admin_sent_email_index') }}" class="btn white red-text"><i class="material-icons left">arrow_back</i>Retour</a>
    </p>
{% endblock %}
