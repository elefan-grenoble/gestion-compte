{% extends 'layout.html.twig' %}

{% block title %}Historique des mails envoyés - {{ site_name }}{% endblock %}

{% block breadcrumbs %}
<a href="{{ path('homepage') }}"><i class="material-icons">home</i></a><i class="material-icons">chevron_right</i>
<a href="{{ path('admin') }}"><i class="material-icons">build</i>&nbsp;Administration</a><i class="material-icons">chevron_right</i>
<i class="material-icons">history</i>&nbsp;Historique des mails
{% endblock %}

{% block content %}
    <h4>Historique des mails envoyés ({{ result_count }})</h4>

    {# Filter form --------- #}
    <ul class="collapsible">
        <li class="active">
            <div class="collapsible-header">
                <i class="material-icons">tune</i>Filtres
            </div>
            <div class="collapsible-body">
                {{ form_start(filter_form) }}
                <div class="row">
                    <div class="col s6 m3 l2">
                        <div class="input-field">
                            {{ form_widget(filter_form.from) }}
                            {# Label kept above the field, like the lists: Materialize would put it back inside the empty field #}
                            {{ form_label(filter_form.from, null, { label_attr: { style: 'transform: translateY(-14px) scale(0.8); transform-origin: 0 0;' } }) }}
                        </div>
                    </div>
                    <div class="col s6 m3 l2">
                        <div class="input-field">
                            {{ form_widget(filter_form.to) }}
                            {{ form_label(filter_form.to, null, { label_attr: { style: 'transform: translateY(-14px) scale(0.8); transform-origin: 0 0;' } }) }}
                        </div>
                    </div>
                    <div class="col s12 m6 l4">
                        <div class="input-field">
                            {{ form_widget(filter_form.recipient) }}
                            {{ form_label(filter_form.recipient) }}
                        </div>
                    </div>
                    <div class="col s12 m6 l4">
                        <div class="input-field">
                            {{ form_widget(filter_form.subject) }}
                            {{ form_label(filter_form.subject) }}
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col s12 m6 l3">
                        <div class="input-field">
                            {{ form_widget(filter_form.source) }}
                            {{ form_label(filter_form.source) }}
                        </div>
                    </div>
                    <div class="col s12 m6 l3">
                        <div class="input-field">
                            {{ form_widget(filter_form.status) }}
                            {{ form_label(filter_form.status) }}
                        </div>
                    </div>
                </div>
                {{ form_widget(filter_form.submit) }}
                {{ form_row(filter_form.page) }}
                {{ form_row(filter_form._token) }}
                {{ form_end(filter_form, {'render_rest': false}) }}
            </div>
        </li>
    </ul>

    {% include 'admin/mail/history/_table.html.twig' with {sent_emails: sent_emails, batches: batches} only %}

    <ul class="pagination">
        <li class="{% if current_page == 1 %}disabled{% else %}waves-effect{% endif %}">
            <a href="#!" data-page="{{ current_page - 1 }}"><i class="material-icons">chevron_left</i></a>
        </li>
        {% for i in range(1, page_count) %}
            <li class="{% if current_page == i %}active{% else %}waves-effect{% endif %}">
                <a href="#!" data-page="{{ i }}">{{ i }}</a>
            </li>
        {% endfor %}
        <li class="{% if current_page == page_count %}disabled{% else %}waves-effect{% endif %}">
            <a href="#!" data-page="{{ current_page + 1 }}"><i class="material-icons">chevron_right</i></a>
        </li>
    </ul>
{% endblock %}

{% block javascripts %}
<script>
    jQuery(function() {
        $('.pagination li:not(.disabled) a').click(function(e) {
            e.preventDefault();
            $('#form_page').val($(this).data('page'));
            $('form[name=form]').submit();
        });
    });
</script>
{% endblock %}
