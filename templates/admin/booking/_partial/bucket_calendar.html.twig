{# Same presentation as /schedule (booking/_partial/list.html.twig): a title per week, then one collapsible card per day.
   Days are open by default since everything is rendered at once. #}
{% set previousWeekIndex = -1 %}

{% for bucketsByjob in bucketsByDay %}
    {% set first_shift = bucketsByjob|first|first %}
    {% set weekIndex = ((first_shift.start | date('W') - 1) % 4) %}

    {# New week --------- #}
    {% if previousWeekIndex != weekIndex %}
        {% if previousWeekIndex != -1 %}</ul>{% endif %}
        {% include "booking/_partial/week_title.html.twig" with { first_shift: first_shift } %}
        {% set previousWeekIndex = weekIndex %}
        <ul class="collapsible collapsible-expandable">
    {% endif %}

    {# New day --------- #}
    <li class="active">
        <div class="collapsible-header">
            <i class="material-icons">{% if date('now') > (bucketsByjob|last|last).end %}event_busy{% else %}event_available{% endif %}</i>
            {{ first_shift.start | date_fr_long }}
        </div>
        <div class="collapsible-body" style="padding: 1rem 0">
            {% for buckets in bucketsByjob %}
                <div class="row" style="display: flex;min-height: 70px;">
                    <div class="col s12">
                        <div style="position: relative">
                            {% set lignes = {} %}
                            {% for bucket in buckets %}
                                {# compute lines #}
                                {% set l = 0 %}
                                {% set break = false %}
                                {% for i in 0..100 if not break %}
                                    {% if lignes[i~'_'] is not defined %}
                                        {% set l = i %}
                                        {% set lignes = lignes|merge({(i~'_'): bucket.end}) %}
                                        {% set break = true %}
                                    {% else %}
                                        {% if lignes[i~'_'] < bucket.start %}
                                            {% set l = i %}
                                            {% set lignes = lignes|merge({(i~'_'): bucket.end}) %}
                                            {% set break = true %}
                                        {% endif %}
                                    {% endif %}
                                {% endfor %}
                                {# / compute lines #}
                                {% include "admin/booking/_partial/bucket_card.html.twig" with { bucket: bucket, start: 6, end: 22, line: l } %}
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </li>
{% endfor %}
{% if previousWeekIndex != -1 %}</ul>{% endif %}
