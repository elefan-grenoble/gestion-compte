# Stack configuration, read by docker compose (copy to .env, chmod 600).
# The application itself is configured by app.env (a Symfony .env file).

# Version deployed: a release without the leading "v" (e.g. 1.48.0)
APP_VERSION=

# Domain served by Caddy, which then gets the TLS certificate by itself
# (DNS must point to this server, ports 80 and 443 reachable).
# Behind an existing reverse proxy that terminates TLS: SITE_ADDRESS=:80,
# HTTP_PUBLISH=127.0.0.1:8080, HTTPS_PUBLISH=127.0.0.1:8443 and
# CADDY_TRUSTED_PROXIES=private_ranges.
SITE_ADDRESS=membres.example.org
#HTTP_PUBLISH=80
#HTTPS_PUBLISH=443
#CADDY_TRUSTED_PROXIES=127.0.0.1/32

# Database (also used in DATABASE_URL in app.env). Passwords end up in a URL:
# generate them with `openssl rand -hex 24` (no / + = characters).
MARIADB_DATABASE=gestion_compte
MARIADB_USER=gestion_compte
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

#APP_ENV_FILE=./app.env
#BACKUP_DIR=./backups
#TZ=Europe/Paris
# php-fpm workers, and the memory limit of the php container
#FPM_MAX_CHILDREN=10
#PHP_MEMORY_LIMIT=2G
